source "Kconfig.zephyr"

config CAN_MODE_LOOPBACK
	bool "Enable CAN hardware loopback mode"
	default n
	help
	  Sets the CAN controller into loopback mode for debugging.
	  Frames are echoed back without needing physical bus connections.
