 *
 * Overlay for NUCLEO-H753ZI with two external SPI-NOR flash chips.
 *
 * Pin mapping (from UM2407):
 *   SCLK  -> CN7 pin 10 (PA5, SPI1_SCK)
 *   MISO  -> CN7 pin 12 (PA6, SPI1_MISO)
 *   MOSI  -> CN7 pin 14 (PA7, SPI1_MOSI)
 *   nCS0  -> CN9 pin 16 (PE4)
 *   nCS1  -> CN9 pin 18 (PE5)
 *
 * PA7 is shared with Ethernet RMII_CRS_DV (SB31), so Ethernet
 * must be disabled when using this pin for SPI.
 */

&mac {
	status = "disabled";
};

&spi1 {
	pinctrl-0 = <&spi1_sck_pa5 &spi1_miso_pa6 &spi1_mosi_pa7>;
	pinctrl-names = "default";
	cs-gpios = <&gpioe 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
		   <&gpioe 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
	status = "okay";

	/* Placeholder jedec-id / size -- update after identification. */
	ext_flash0: flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <1875000>;
		jedec-id = [ef 40 18];
		size = <134217728>;
	};

	ext_flash1: flash@1 {
		compatible = "jedec,spi-nor";
		reg = <1>;
		spi-max-frequency = <1875000>;
		jedec-id = [ef 40 18];
		size = <134217728>;
	};
};
